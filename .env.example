# Copy to .env. Every value below has a working default, so a clean clone runs
# the full demo offline without any of these being set.

# local | production
AEGIS_ENVIRONMENT=local

# SQLite locally. In production, set this to a Postgres connection string
# using the postgresql+asyncpg:// scheme.
AEGIS_DATABASE_URL=sqlite+aiosqlite:///./aegis.db

# Explicit CORS allowlist, comma separated. Never set this to *.
AEGIS_CORS_ORIGINS=http://localhost:3000

# Bearer token guarding the control plane: approvals, policy writes, demo reset.
# Read endpoints stay public. Change this before deploying.
AEGIS_DEMO_TOKEN=aegis-local-dev-token

# replay serves recorded judge verdicts and needs no key.
# live calls the Gemini API. mock uses scripted responses for tests.
AEGIS_LLM_MODE=replay
AEGIS_GEMINI_API_KEY=

# Seconds a held call waits for a human before it is refused.
AEGIS_APPROVAL_TIMEOUT_SECONDS=120

# Frontend. Locally, the backend runs on its own port. In the Vercel
# deployment the backend is same-origin behind a rewrite, so this becomes a
# relative path there instead: NEXT_PUBLIC_API_URL=/api/backend
NEXT_PUBLIC_API_URL=http://localhost:8000
